##! experimental.access_modifiers experimental.parameters

// =============================================================================
// MERCHANDISING MODEL — product assortment, brand & category performance.
// Imports the shared base and extends product / order-line sources.
// Links only; concept definitions live in the Knowledge Plane (kp/ OKF bundle).
// =============================================================================
import "base.malloy"

// ---------- PRODUCT_PERFORMANCE — product-centric assortment & margin --------
# model = "merchandising"
#(kp) concept = "kp:Product"
source: product_performance(reporting_currency::string is "USD") is product extend {

  #(kp) is_about_role = "kp:recordsSaleOf"
  join_many: lines is order_line_in_context(reporting_currency is reporting_currency)
    on ProductKey = lines.ProductKey

  dimension:
  #(kp) concept = "kp:ProductSubCategory"
  sub_category is SubCategoryName
  #(kp) concept = "kp:ProductColor"
  color is Color
  #(kp) concept = "kp:ProductManufacturer"
  manufacturer is Manufacturer

  list_price_margin is (Price - Cost) / Price

  measure:
  #(kp) concept = "kp:TotalSales"
  total_sales is lines.line_revenue.sum()
  #(kp) concept = "kp:Margin"
  margin is lines.line_revenue.sum() - lines.line_cost.sum()
  #(kp) concept = "kp:TotalUnits"
  total_units is lines.Quantity.sum()
  #(kp) concept = "kp:ListPriceMarginPercent"
  avg_list_price_margin_percent is list_price_margin.avg()
}

// ---------- PRODUCT_LINE — distinct products actually sold --------------------
#(kp) concept = "kp:OrderLine"
source: product_line(reporting_currency::string is "USD") is
  order_line_in_context(reporting_currency is reporting_currency) extend {

  measure:
  #(kp) concept = "kp:DistinctProductsSold"
  distinct_products_sold is sold_product.count()
}
